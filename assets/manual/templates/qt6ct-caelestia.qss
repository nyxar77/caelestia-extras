/* Prism's toolbar can ignore the custom QPalette text roles under Breeze. */
QToolBar {
  color: #{{ onSurface.hex }};
  background-color: #{{ surface.hex }};
}

QToolBar QToolButton {
  color: #{{ onSurface.hex }};
  background-color: transparent;
}

QToolBar QToolButton:hover,
QToolBar QToolButton:checked {
  color: #{{ onPrimaryContainer.hex }};
  background-color: #{{ primaryContainer.hex }};
}

QToolBar QToolButton:disabled {
  color: #{{ onSurfaceVariant.hex }};
}

QMenuBar,
QMenu {
  color: #{{ onSurface.hex }};
  background-color: #{{ surfaceContainer.hex }};
}

QMenuBar::item:selected,
QMenu::item:selected {
  color: #{{ onPrimaryContainer.hex }};
  background-color: #{{ primaryContainer.hex }};
}
