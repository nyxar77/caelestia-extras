/*
  qBittorrent top-bar compatibility shim.

  Breeze draws these controls, and the shared Qt palette remains the source of
  every colour. Explicit semantic roles keep qBittorrent's menu and toolbar
  readable in both active and inactive windows without enabling its custom
  theme engine or styling the rest of the application.
*/
QMenuBar,
QToolBar {
  color: palette(window-text);
  background-color: palette(window);
  border-bottom: 1px solid palette(mid);
}

QMenuBar::item,
QToolBar QToolButton {
  color: palette(button-text);
  background-color: transparent;
}

QMenuBar::item:selected,
QToolBar QToolButton:hover,
QToolBar QToolButton:checked {
  color: palette(highlighted-text);
  background-color: palette(highlight);
}

QToolBar QToolButton:disabled {
  color: palette(mid);
}
