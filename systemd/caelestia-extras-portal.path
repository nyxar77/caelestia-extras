[Unit]
Description=Watch Caelestia portal theme output

[Path]
PathChanged=%h/.local/state/caelestia/theme/gtk-portal.css
PathChanged=%h/.local/state/caelestia/theme/gtk-global.css
PathChanged=%h/.local/state/caelestia/theme/qt6ct-caelestia.conf
PathChanged=%h/.local/state/caelestia/theme/qt6ct-portal.qss
Unit=caelestia-extras-portal.service

[Install]
WantedBy=graphical-session.target
